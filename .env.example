# Copy to .env and fill in. Never commit .env or anything under secrets/.

DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Extra dev hosts, e.g. your LAN IP or ngrok host for testing on a phone
EXTRA_ALLOWED_HOSTS=

# Browser clients allowed to call the API (the admin dashboard), comma-separated.
# With DEBUG=True any http://localhost:<port> is also allowed (flutter run -d chrome).
CORS_ALLOWED_ORIGINS=https://admin.safarichap.co.tz

# Postgres
DB_NAME=safarichap
DB_USER=safarichap
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Redis (docker-compose overrides these to the redis service)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1

# Firebase (same project as the app). Use ONE of these.
# Dev: put the file in ./secrets/ (git-ignored). Prod compose mounts ./secrets at /run/secrets/safarichap.
FIREBASE_CREDENTIALS_PATH=secrets/firebase-adminsdk.json
FIREBASE_CREDENTIALS_JSON=

# Fernet key for KYC document numbers:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ClickPesa (mobile money)
CLICK_PESA_CLIENT_ID=
CLICK_PESA_API_KEY=
# Register the webhook in ClickPesa as https://<host>/api/payments/webhooks/clickpesa/?secret=<this value>
CLICK_PESA_WEBHOOK_SECRET=

# Flutterwave (cards: USD/EUR/GBP goals)
FLUTTERWAVE_SECRET_KEY=
# Set the same value as "Secret hash" in the Flutterwave dashboard; webhook URL: /api/payments/webhooks/card/
FLUTTERWAVE_WEBHOOK_HASH=
CARD_CHECKOUT_REDIRECT_URL=https://safarichap.co.tz/payments/done

# Email (operator booking emails, optional)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_OPERATOR_ON_BOOKING=False

# Rate limits (DRF format N/sec|min|hour|day). Defaults shown.
# THROTTLE_USER=120/min
# THROTTLE_ANON=30/min
# THROTTLE_PAYMENTS=20/min
# THROTTLE_KYC=5/min
# THROTTLE_WEBHOOKS=600/min
# THROTTLE_QUOTES=60/min
# THROTTLE_GOAL_CHANGES=20/min
# THROTTLE_ACCOUNT=10/min
# Proxies in front of Django (nginx = 1). Use 0 when running runserver with no proxy.
# NUM_PROXIES=1

# Production only
CSRF_TRUSTED_ORIGINS=
SENTRY_DSN=
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me
GRAFANA_ROOT_URL=
# Read-only Postgres user for Grafana's business dashboard (created by the app entrypoint;
# column-level access only, no personal data). Dev defaults to grafana-dev when unset.
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=
