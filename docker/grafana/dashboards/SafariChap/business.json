          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, '$bucket'), method AS metric,\n       100.0 * count(*) FILTER (WHERE status = 'failed') / NULLIF(count(*) FILTER (WHERE status IN ('success', 'failed')), 0) AS value\nFROM payments_payment WHERE $__timeFilter(created_at) GROUP BY 1, 2 ORDER BY 1"
