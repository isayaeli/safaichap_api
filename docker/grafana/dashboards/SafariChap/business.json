    {
      "type": "timeseries",
      "title": "Time to settle",
      "description": "From starting a payment to its final status. Slow settlement means users wait on the status screen.",
      "id": 13,
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "safarichap-db"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "safarichap-db"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(settled_at, '$bucket'),\n       percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM settled_at - created_at)) AS \"Median\",\n       percentile_cont(0.95) WITHIN GROUP (ORDER BY extract(epoch FROM settled_at - created_at)) AS \"95th percentile\"\nFROM payments_payment WHERE settled_at IS NOT NULL AND $__timeFilter(settled_at) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
